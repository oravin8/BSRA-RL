<mujocoinclude>
  <worldbody>
    <!-- MEMBER TODO 2.1: Add body cart at 0 0 0.20, joint slider, and
         geom cart_geom. Use the dimensions and explicit mass in docs/ONBOARDING.md.
         Nest body pole at 0 0 0.08 with joint hinge and geom pole_geom.
         At zero joint positions, the pole points up along +z. -->
    <body name="cart"
          pos="0 0 0.20">
      <joint name="slider"
          type="slide"
          axis="1 0 0"
          range="-1.25 1.25"
          damping="1">
      <geom name="cart-geom"
            type="box"
            size="0.15 0.1 0.08"
            mass="10"/>
      </body>

    <body name="pole"
          pos="0 0 0.08">
      <joint name="hinge"
          type="hinge"
          axis="0 1 0"
          range="-90 90"
          damping="1" />
      <geom name="pole-geom"
          type="capsule"
          size="0.04"
          fromto="0 0 0 0 0 0.75"
          mass="5"/>
      </body>
            
  </worldbody>
  <actuator>
    <!-- MEMBER TODO 2.2: Add cart_motor on slider. Set the control limit
         and gear explicitly. The pole has no actuator. -->
    <motor name="cart_motor"
      ctrlrange="-3 3"
      joint="slider"
      gear="100"/>
  </actuator>
</mujocoinclude>
